# Django Configuration
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# PostgreSQL Database Configuration (Supabase)
# Set DATABASE_URL instead of the DB_* values when your provider supplies a URL.
DATABASE_URL=
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_supabase_database_password
DB_HOST=your-project-ref.supabase.co
DB_PORT=5432
DB_SSLMODE=require

# Supabase Storage (S3-compatible API)
USE_SUPABASE_STORAGE=True
AWS_ACCESS_KEY_ID=your_supabase_storage_access_key
AWS_SECRET_ACCESS_KEY=your_supabase_storage_secret_key
AWS_STORAGE_BUCKET_NAME=media
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=https://your-project-ref.supabase.co/storage/v1/s3
AWS_S3_SIGNATURE_VERSION=s3v4
AWS_S3_ADDRESSING_STYLE=path
AWS_S3_FILE_OVERWRITE=False
AWS_S3_USE_SSL=True

# SSLCommerz Payment Gateway Configuration
SSL_COMMERZ_STORE_ID=your-store-id-here
SSL_COMMERZ_STORE_PASSWORD=your-store-password-here
SSLCOMMERZ_API_URL=https://sandbox.sslcommerz.com/gwprocess/v4/api.php

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@touchandsolve.com
